    if UIS:IsKeyDown(Enum.KeyCode.S)           then move-=Vector3.new(cf.LookVector.X,0,cf.LookVector.Z).Unit end
    if UIS:IsKeyDown(Enum.KeyCode.A)           then move-=Vector3.new(cf.RightVector.X,0,cf.RightVector.Z).Unit end
